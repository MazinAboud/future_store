# ============================================================================
#  Future Store — ما لا يُرفع إلى Git
# ============================================================================

# ── الأسرار: أهم سطر في هذا الملف ──────────────────────────────────────────
# includes/config.php يحوي مستخدم قاعدة البيانات وكلمة سرها. رفعه مرة واحدة
# إلى مستودع عام يكشف كلمة السر للعالم، وتبقى في تاريخ Git للأبد حتى لو
# حُذفت لاحقًا — حذف الملف في commit جديد لا يمحو الـ commit الذي أضافه.
# البديل المرفوع هو includes/config.example.php بقيم وهمية: ينسخه من يشغّل
# المشروع إلى config.php ويضع قيمه هو.
includes/config.php

# ── ورقة بيانات الدخول ─────────────────────────────────────────────────────
# قائمة كلمات سر الحسابات بنص صريح، للاستخدام المحلي وقت التطوير والعرض فقط.
# رفعها إلى Git يسلّم كل حساب في النظام لمن يقرأ المستودع — ويبقى في التاريخ
# للأبد حتى لو حُذف الملف لاحقًا.
CREDENTIALS.local.md
*credentials*
*CREDENTIALS*
*_Accounts.docx
*.docx
*.xlsx
*.pdf

# ── تقارير التدقيق والذاكرة الداخلية ───────────────────────────────────────
# تصف بنية الحماية ونقاط الضعف المعروفة وتفاصيل البيئة. مفيدة لك محليًا،
# لكنها في مستودع عام خريطة جاهزة لمن يريد مهاجمة الموقع.
CLAUDE.md
SECURITY_AUDIT.md
PERFORMANCE_AUDIT.md
PRODUCTION_READINESS.md
TEST_REPORT.md
BUSINESS_LOGIC_AUDIT.md
DATABASE_AUDIT.md
API_SECURITY_AUDIT.md
ATTACK_SURFACE.md

# ── مرفوعات المستخدمين ─────────────────────────────────────────────────────
# محتوى المجلد بيانات وقت التشغيل، لا كود. المجلد نفسه يبقى في المستودع عبر
# .gitkeep و.htaccess (وهو ملف حماية ضروري: يمنع تنفيذ أي سكربت داخل المجلد).
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# ── نسخ احتياطية ومخلّفات قواعد البيانات ───────────────────────────────────
*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.old
*.save
*.orig
*.rej
!schema.sql

# ── سجلات وملفات مؤقتة ─────────────────────────────────────────────────────
*.log
*.tmp
*.cache
error_log
php_errors.log

# ── بيئة ────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── ملفات المحرّرات وأنظمة التشغيل ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── تبعيات (المشروع لا يستخدمها حاليًا، والاستثناء وقائي) ──────────────────
/vendor/
/node_modules/
composer.lock
package-lock.json
