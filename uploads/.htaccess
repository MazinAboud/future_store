# ============================================================================
#  Same execution lockdown as assets/images/products/.htaccess.
#  See that file for the full reasoning.
#
#  This folder is not currently a live upload target — admin/product-form.php
#  writes to assets/images/products/ instead — but it exists in the tree, is
#  named "uploads", and already holds one image. A folder in that state is
#  exactly the kind of thing a later change points an upload handler at without
#  anyone remembering to harden it first.
# ============================================================================

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|asp|aspx|sh|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .phar .cgi .pl .py
